    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.7.7",
    "chart.js": "^4.4.6",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "highcharts": "^12.1.2",
    "highcharts-react-official": "^3.2.1",
    "io": "^1.3.2",
    "react": "^18.2.0",
